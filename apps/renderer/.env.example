PORT=3001
RENDERER_SECRET=change-me-to-a-long-random-string

# Optional: set only if this renderer must reach the internet through an
# egress/corporate proxy. Leave unset for a normal VPS with direct outbound access.
RENDERER_HTTP_PROXY=

# NEVER set this to "true" in production. Disables TLS certificate validation
# for every target URL. Only for smoke-testing behind a dev sandbox's own
# TLS-intercepting proxy.
RENDERER_INSECURE_IGNORE_CERT_ERRORS=
